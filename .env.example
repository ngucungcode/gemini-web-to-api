# Server Configuration
PORT=4981
LOG_LEVEL=info
APP_ENV=development
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Admin token for POST/DELETE /admin/accounts (optional but recommended).
# Send as: Authorization: Bearer <token>  (or X-Admin-Token / ?token=)
ADMIN_TOKEN=

# Gemini accounts: pick ONE style, or mix (env first, files next).
#
# Style A — files (easiest, multi-account):
#   Use extension/ (Load unpacked in chrome://extensions), open gemini.google.com,
#   Read cookies -> Save as cookies/acc1.txt, cookies/acc2.txt, ...
#   Slot: tab URL /u/2/ -> write cookies/acc1.auth containing "2" (or acc2_u1.txt form).
#   Or cookies/accounts.json: [{"name":"acc1","cookies":"...","auth_user":"2"}]
GEMINI_COOKIES_DIR=cookies
#
# Style B — env (1..10 accounts):
#   Paste the complete Cookie header from a Gemini batchexecute request.
#   Same-tab rule: cookie + slot must come from the same browser tab.
GEMINI_COOKIES=
# If that request URL contains /u/2/, set 2 here. Empty when no /u/<number>/.
GEMINI_AUTH_USER=
# Extra accounts: GEMINI_COOKIES_2.._10 with GEMINI_AUTH_USER_2.._10.
# GEMINI_COOKIES_2=
# GEMINI_AUTH_USER_2=
GEMINI_REFRESH_INTERVAL=1440
GEMINI_MAX_RETRIES=3
GEMINI_TEMPORARY=false
